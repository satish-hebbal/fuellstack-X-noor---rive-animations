# Copy to `.env` for local dev. On Vercel, set these two under
# Settings → Environment Variables instead (then redeploy — Vite bakes them in
# at build time, so changing them requires a new build).
#
# Leave both blank to use the local `src/rive/` folder instead of Drive.
#
# Full walkthrough in the README under "Serving from Google Drive".

# The part of your Drive folder's URL after /folders/
# https://drive.google.com/drive/folders/THIS_PART
VITE_DRIVE_FOLDER_ID=

# Google Cloud API key with the Drive API enabled.
# NOTE: this ends up in the client bundle and is publicly visible. Restrict it
# to your site's domain (Application restrictions → HTTP referrers) and to the
# Drive API (API restrictions). That's what keeps it from being useful to
# anyone else.
VITE_DRIVE_API_KEY=
